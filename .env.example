# ==============================================================================
# OCCUPIFY IDENTITY & API GATEWAY ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
# HTTP port for the Occupify Identity & API Gateway service (Default: 8181)
SERVER_PORT=8181

# ------------------------------------------------------------------------------
# Downstream Microservices Routing URLs
# ------------------------------------------------------------------------------
# Core Marketplace Service (:8182) - /projects/**, /applications/**, /reviews/**, /bids/**
SERVICES_CORE_URL=http://localhost:8182

# Payment Service (:8183) - /contracts/**, /wallets/**, /payments/**
SERVICES_PAYMENT_URL=http://localhost:8183

# Notification Service (:8184) - /notifications/**
SERVICES_NOTIFICATION_URL=http://localhost:8184

# Administration Service (:8185) - /admin/**, /audit-logs/**, /reports/**
SERVICES_ADMINISTRATION_URL=http://localhost:8185

# Identity / Auth Service (:8181) - /auth/**
SERVICES_AUTH_URL=http://localhost:8181

# ------------------------------------------------------------------------------
# Infrastructure (Docker Compose: PostgreSQL & Redis)
# ------------------------------------------------------------------------------
# PostgreSQL Database for Identity Service
POSTGRES_DB=occupify_identity
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5530

# Redis Cache & Session Store
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# JWT Authentication Configuration (HS512 requires >= 64 characters)
# ------------------------------------------------------------------------------
JWT_SECRET=secret-jwt-key-for-signing-must-be-long-enough-for-hs512-algorithm-minimum-64-bytes!
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ------------------------------------------------------------------------------
# Infrastructure Hosts
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
REDIS_HOST=localhost

# ------------------------------------------------------------------------------
# OTP (One-Time Password) Configuration
# ------------------------------------------------------------------------------
OTP_LENGTH=6
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60

# ------------------------------------------------------------------------------
# RabbitMQ Message Broker Configuration
# ------------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_NOTIFICATION_EXCHANGE=occupify.notification.exchange
RABBITMQ_USER_REGISTERED_ROUTING_KEY=user.registered
RABBITMQ_PASSWORD_RESET_ROUTING_KEY=user.password-reset

